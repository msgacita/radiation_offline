&offline_control
  radiation_scheme     = 'rrtmg'        ! 'rrtmg' ou 'ecrad'
  path_pressure_level  = 'era5_pressure_level.nc'
  path_single_level    = 'era5_single_level.nc'
!SP
 ilon_start           = 22       ! 1-based indices into the
 ilon_end             = 41       ! ERA5 file's own
 ilat_start           = 56       ! longitude/latitude
 ilat_end             = 67       ! coordinate arrays
!PTR
! ilon_start           = 59       ! 1-based indices into the
! ilon_end             = 61       ! ERA5 file's own
! ilat_start           = 1       ! longitude/latitude
! ilat_end             = 2       ! coordinate arrays
!CGR
!  ilon_start           = 1       ! 1-based indices into the
!  ilon_end             = 3       ! ERA5 file's own
!  ilat_start           = 46       ! longitude/latitude
!  ilat_end             = 48       ! coordinate arrays
!
  itime_start          = 1
  itime_end            = 24
  path_output          = 'output.nc'
  ecrad_namelist_path  = 'config.nam'   ! só lido se radiation_scheme='ecrad'
/
